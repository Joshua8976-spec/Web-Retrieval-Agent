# ==============================================================================
# Web Information Retrieval Agent - Environment Configuration
# ==============================================================================

# LLM Endpoint Configuration (OpenAI-compatible)
# For vLLM running on AMD ROCm: LLM_BASE_URL=http://localhost:8000/v1, LLM_API_KEY=EMPTY
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# Agent Navigation Limits & BM25 Pruning
AGENT_MAX_PAGES=10
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=3
BM25_TOP_LINKS=25
BM25_TOP_CHUNKS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Safety & Networking
USER_AGENT=WebRetrievalAgent/1.0 (+https://github.com/amd-ai-league)
MAX_PAGE_SIZE_BYTES=5242880
RATE_LIMIT_DELAY_SECONDS=0.5
ALLOW_EXTERNAL_DOMAINS=false
ENABLE_PLAYWRIGHT_FALLBACK=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
